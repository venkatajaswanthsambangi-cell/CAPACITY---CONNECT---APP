# CAPACITY CONNECT - Production Environment Variables Template
# Copy this file to .env for local testing or set these variables in your hosting provider dashboard (Render, Railway, Cloud Run).

# Environment Mode: Set to 'production' for deployment
NODE_ENV=production

# Server Port: Required by cloud providers (Render, Railway, Fly.io, Cloud Run supply this dynamically)
PORT=3000

# Google Gemini API Key: Required for real-time AI Learning Assistant
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Initial Super Administrator Email
SUPER_ADMIN_EMAIL=venkatajaswanthsambangi@gmail.com
